{
    "name": "magento/project-enterprise-edition",
    "description": "eCommerce Platform for Growth (Enterprise Edition)",
    "type": "project",
    "license": [
        "proprietary"
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "laminas/laminas-dependency-plugin": true,
            "magento/*": true
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "version": "2.4.4",
    "require": {
        "abelbm/magento2-disablefrontend": "^1.1",
        "amasty/base": "^1.17",
        "amasty/blog": "^2.10",
        "amasty/feed": "^2.7",
        "amasty/label": "^2.3",
        "amasty/module-elastic-search": "^2.2",
        "amasty/module-elastic-search-pro": "^1.16",
        "amasty/module-shopby-premium": "^1.12",
        "amasty/xsearch": "^1.23",
        "statuscue/magento2-seosuite": "dev-main",
        "statuscue/module-m2-geo": "dev-main",
        "statuscue/module-m2-bluewood": "dev-develop",
        "statuscue/scue-m2-module-geodata": "dev-master",
        "statuscue/scue-m2-module-novaposhta": "dev-master",
        "statuscue/magento-2-module-esputnik": "dev-main",
        "liqpay/liqpay": "^1.2",
        "magefan/module-cli": "^2.1.1",
        "magento/composer-dependency-version-audit-plugin": "~0.1",
        "magento/composer-root-update-plugin": "~2.0",
        "magento/product-enterprise-edition": "2.4.6",
        "phoenix-media/magento2-cloud-build": "^1.0"
    },
    "autoload": {
        "exclude-from-classmap": [
            "**/dev/**",
            "**/update/**",
            "**/Test/**"
        ],
        "files": [
            "app/etc/NonComposerComponentRegistration.php"
        ],
        "psr-0": {
            "": [
                "app/code/",
                "generated/code/"
            ]
        },
        "psr-4": {
            "Magento\\": "app/code/Magento/",
            "Magento\\Framework\\": "lib/internal/Magento/Framework/",
            "Magento\\Setup\\": "setup/src/Magento/Setup/"
        }
    },
    "require-dev": {
        "allure-framework/allure-phpunit": "~1.5.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7.0",
        "friendsofphp/php-cs-fixer": "~3.3.0",
        "lusitanian/oauth": "~0.8.10",
        "magento/magento-coding-standard": "*",
        "magento/magento2-functional-testing-framework": "^3.7",
        "pdepend/pdepend": "~2.10.0",
        "phpmd/phpmd": "^2.9.1",
        "phpstan/phpstan": "~1.2.0",
        "phpunit/phpunit": "~9.5.0",
        "sebastian/phpcpd": "^6.0.3",
        "squizlabs/php_codesniffer": "~3.6.0",
        "symfony/finder": "^5.2"
    },
    "conflict": {
        "gene/bluefoot": "*"
    },
    "autoload-dev": {
        "psr-4": {
            "Magento\\PhpStan\\": "dev/tests/static/framework/Magento/PhpStan/",
            "Magento\\Sniffs\\": "dev/tests/static/framework/Magento/Sniffs/",
            "Magento\\TestFramework\\Inspection\\": "dev/tests/static/framework/Magento/TestFramework/Inspection/",
            "Magento\\TestFramework\\Utility\\": "dev/tests/static/framework/Magento/TestFramework/Utility/",
            "Magento\\Tools\\": "dev/tools/Magento/Tools/",
            "Magento\\Tools\\Sanity\\": "dev/build/publication/sanity/Magento/Tools/Sanity/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": {
        "magefan-cli-m2": {
            "type": "composer",
            "url": "https://ZT1rsDBJrU11RfjS3M21oIaFZQEV1ScF:1hdvymUulcXKkE94nTZFmW1IhajhAj0b@magefan.com/repo/"
        },
        "amasty": {
            "type": "composer",
            "url": "https://composer.amasty.com/enterprise/"
        },
        "statuscue/scue-m2-module-geodata": {
            "type": "git",
            "url": "https://github.com/statuscue/scue-m2-module-geodata.git"
        },
        "statuscue/scue-m2-module-novaposhta": {
            "type": "git",
            "url": "https://github.com/statuscue/scue-m2-module-novaposhta.git"
        },
        "statuscue/magento-2-module-esputnik": {
            "type": "git",
            "url": "https://github.com/statuscue/scue-m2-module-esputnik.git"
        },
        "magento": {
            "type": "composer",
            "url": "https://repo.magento.com/"
        },
        "statuscue/scue-m2-module-bluewood": {
            "type": "git",
            "url": "https://github.com/statuscue/scue-m2-module-bluewood.git"
        },
        "statuscue/m2-module-geodata": {
            "type": "git",
            "url": "https://github.com/statuscue/scue-m2-module-geo.git"
        },
        "statuscue/magento2-seosuite": {
            "type": "git",
            "url": "https://github.com/statuscue/magento2-seo-suite.git"
        }
    },
    "extra": {
        "magento-force": "override"
    }
}
